{%- for line in subtotal_line_items %}
{%- assign line_title = line.presentment_title | default: line.title | default: line.product.title %}
          <tr>
            <td valign="top" style="padding:7px 12px 7px 0;{{ ff }}font-size:16px;line-height:22px;color:#3a2012;">{{ line_title | escape }} × {{ line.quantity }}</td>
            <td align="right" valign="top" style="padding:7px 0;{{ ff }}font-size:16px;line-height:22px;color:#3a2012;white-space:nowrap;">{{ line.original_line_price | money }}</td>
          </tr>
{%- endfor %}
{%- if total_discounts > 0 %}
          <tr>
            <td valign="top" style="padding:0 12px 7px 0;{{ ff }}font-size:16px;line-height:22px;color:#3a2012;">{{ t_discount }}</td>
            <td align="right" valign="top" style="padding:0 0 7px;{{ ff }}font-size:16px;line-height:22px;color:#3a2012;white-space:nowrap;">−{{ total_discounts | money }}</td>
          </tr>
{%- endif %}
          <tr>
            <td valign="top" style="border-top:2px solid #3a2012;padding:10px 12px 6px 0;{{ ff }}font-size:19px;line-height:24px;font-weight:bold;color:#3a2012;">{{ t_total }}</td>
            <td align="right" valign="top" style="border-top:2px solid #3a2012;padding:10px 0 6px;{{ ff }}font-size:19px;line-height:24px;font-weight:bold;color:#3a2012;white-space:nowrap;">{{ total_price | money_with_currency }}</td>
          </tr>
{%- if tax_price > 0 %}
          <tr>
            <td valign="top" style="padding:0 12px 4px 0;{{ ff }}font-size:14px;line-height:20px;color:#7a4a2c;">{{ t_vat }}{{ vat_rate }}</td>
            <td align="right" valign="top" style="padding:0 0 4px;{{ ff }}font-size:14px;line-height:20px;color:#7a4a2c;white-space:nowrap;">{{ tax_price | money }}</td>
          </tr>
{%- endif %}
        </table>
{%- if pay_label != blank or billing_address %}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:14px;border-top:2px dashed #c3af89;">
          <tr>
{%- if pay_label != blank %}
            <td class="stack" width="50%" valign="top" style="padding:14px 10px 0 0;{{ ff }}font-size:14px;line-height:20px;color:#3a2012;">
              <div style="padding-bottom:3px;{{ fh }}font-size:15px;line-height:20px;color:#3a2012;">{{ t_paid_with }}</div>
              {{ pay_label | escape }}
            </td>
{%- endif %}
{%- if billing_address %}
            <td class="stack" width="50%" valign="top" style="padding:14px 0 0 10px;{{ ff }}font-size:14px;line-height:20px;color:#3a2012;">
              <div style="padding-bottom:3px;{{ fh }}font-size:15px;line-height:20px;color:#3a2012;">{{ t_billing }}</div>
              {{ billing_address | format_address }}
            </td>
{%- endif %}
          </tr>
        </table>
{%- endif %}
      </td></tr>
    </table>
  </td></tr>

{%- if has_access %}

  <tr><td align="center" style="padding:22px 12px 0;{{ ff }}font-size:13px;line-height:20px;color:#e4c9a4;"><b style="color:#fae025;">{{ t_withdrawal_label }}</b> {{ t_withdrawal }}</td></tr>
{%- endif %}

  <tr><td align="center" style="padding:26px 12px 0;{{ ff }}font-size:13px;line-height:21px;color:#d9b898;">
    {{ t_questions }} <a href="mailto:kontakt@disputt.site" style="color:#f8e6b8;text-decoration:underline;">kontakt@disputt.site</a><br>
    <a href="https://disputt.site/vilkar.html" target="_blank" style="color:#f8e6b8;text-decoration:underline;">{{ t_terms }}</a> · <a href="https://disputt.site/personvern.html" target="_blank" style="color:#f8e6b8;text-decoration:underline;">{{ t_privacy }}</a><br><br>
    Pesom Holding AS · org.nr. 923 729 674 MVA · Agathe Grøndahls gate 46, 0478 Oslo
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
{%- comment %} Kunder i Danmark og Tyskland skal få vilkårene og angreretten som PDF (det er det Shopifys standardmal også gjør) {% endcomment -%}
{%- if billing_address.country_code == 'DE' or billing_address.country_code == 'DK' -%}
  {%- if shop.terms_of_service.body != blank -%}
    {{ shop.terms_of_service | attach_as_pdf: t_pdf_terms }}
  {%- endif -%}
  {%- if shop.refund_policy.body != blank -%}
    {{ shop.refund_policy | attach_as_pdf: t_pdf_refund }}
  {%- endif -%}
{%- endif -%}

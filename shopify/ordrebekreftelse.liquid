{%- comment %} Hva ordren er {% endcomment -%}
{%- assign has_access = false -%}
{%- if attributes.kode != blank and attributes.samtykke != blank -%}
  {%- assign has_access = true -%}
{%- endif -%}
{%- comment %} Venter betalingen ennå (ventende, godkjent men ikke trukket, delvis betalt)? Da er ikke tilgangen gitt. En ordre som er betalt og senere refundert, venter ikke: det er den som sendes på nytt når du prøver malen. {% endcomment -%}
{%- assign is_waiting = false -%}
{%- if financial_status == 'pending' or financial_status == 'authorized' or financial_status == 'partially_paid' -%}
  {%- assign is_waiting = true -%}
{%- endif -%}

{%- comment %} Hvilken pakke: kjennes på variant-ID, ellers på navnet. Har ordren flere, teller den dyreste (3 Livstid, 2 For ett år, 1 En kveld) {% endcomment -%}
{%- assign rank = 0 -%}
{%- for line in subtotal_line_items -%}
  {%- assign variant = line.variant_id | default: line.variant.id | append: '' -%}
  {%- assign line_name = line.title | default: line.product.title | append: '' -%}
  {%- assign line_rank = 0 -%}
  {%- if variant == '67625896870022' or line_name contains 'Livstid' -%}
    {%- assign line_rank = 3 -%}
  {%- elsif variant == '67625896280198' or line_name contains 'For ett år' -%}
    {%- assign line_rank = 2 -%}
  {%- elsif variant == '67625895526534' or line_name contains 'En kveld' -%}
    {%- assign line_rank = 1 -%}
  {%- endif -%}
  {%- if line_rank > rank -%}
    {%- assign rank = line_rank -%}
  {%- endif -%}
{%- endfor -%}
{%- assign plan_text = '' -%}
{%- assign plan_note = '' -%}
{%- if rank == 1 -%}
  {%- assign plan_text = t_plan_evening -%}
  {%- assign plan_note = t_renew -%}
{%- elsif rank == 2 -%}
  {%- assign plan_text = t_plan_year -%}
  {%- assign plan_note = t_renew -%}
{%- elsif rank == 3 -%}
  {%- assign plan_text = t_plan_lifetime -%}
  {%- assign plan_note = t_once -%}
{%- else -%}
  {%- assign plan_note = t_plan_generic -%}
{%- endif -%}

{%- comment %} Betalingsmåten: kortet med de fire siste sifrene, ellers navnet på betalingsmåten {% endcomment -%}
{%- assign pay_label = '' -%}
{%- for transaction in transactions -%}
  {%- if pay_label == '' and transaction.status == 'success' -%}
    {%- if transaction.kind == 'sale' or transaction.kind == 'capture' -%}
      {%- if transaction.payment_details.credit_card_company -%}
        {%- capture pay_label -%}
          {{ transaction.payment_details.credit_card_company }}{% if transaction.payment_details.credit_card_last_four_digits %} •••• {{ transaction.payment_details.credit_card_last_four_digits }}{% endif %}
        {%- endcapture -%}
      {%- else -%}
        {%- assign pay_label = transaction.payment_details.payment_method_display_name | default: transaction.gateway_display_name -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- comment %} Mva-linjen: «Herav mva (25 %)» når ordren har én skattelinje, ellers bare «Herav mva» {% endcomment -%}
{%- assign vat_rate = '' -%}
{%- if tax_lines.size == 1 and tax_lines.first.rate_percentage -%}
  {%- assign vat_percent = tax_lines.first.rate_percentage | round: 1 | remove: '.0' | replace: '.', ',' -%}
  {%- capture vat_rate %} ({{ vat_percent }} %){% endcapture -%}
{%- endif -%}

